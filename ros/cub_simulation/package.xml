<?xml version="1.0"?>
<package format="3">
  <name>cub_simulation</name><version>0.1.0</version>
  <description>Simulation launch files and the ROS velocity-command interface for Cub.</description>
  <maintainer email="cub@todo.todo">cub</maintainer><license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend><exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>cub_commander</exec_depend><exec_depend>rosbridge_server</exec_depend>
  <test_depend>python3-pytest</test_depend><test_depend>rclpy</test_depend>
  <test_depend>sensor_msgs</test_depend><test_depend>geometry_msgs</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
