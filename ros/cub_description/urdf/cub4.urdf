<?xml version="1.0"?>
<robot name="cub4_robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ベースリンク -->
  <link name="base_link">
     <visual>
      <geometry>
        <mesh filename="file://$(find cub_description)/meshes/cub4-comp.obj" scale="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 1.57"/>
    </visual>
    <collision>
      <geometry>
        <mesh filename="file://$(find cub_description)/meshes/cub4-comp.obj" scale="0.1 0.1 0.1"/>
      </geometry>
      <origin xyz="0.0 0.0 0.0" rpy="1.57 0.0 1.57"/>
    </collision>
  </link>

  <!-- base_footprint -->
  <link name="base_footprint">
    <visual>
      <!-- <geometry>
        <cylinder radius="0.05" length="0.01"/>
      </geometry> -->
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- GPSリンク -->
  <link name="gnss_main_link">
    <visual>
      <!-- <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry> -->
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>
  <link name="gnss_sub_link">
    <visual>
      <!-- <geometry>
        <cylinder radius="0.03" length="0.01"/>
      </geometry> -->
      <material name="white">
        <color rgba="1 1 1 1"/>
      </material>
    </visual>
  </link>

  <!-- Velodyne LiDAR -->
  <link name="velodyne">
    <visual>
      <!-- <geometry>
        <cylinder radius="0.07" length="0.01"/>
      </geometry> -->
      <material name="green">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <!-- Livox LiDAR -->
  <link name="livox_frame">
    <visual>
      <!-- <geometry>
        <cylinder radius="0.05" length="0.01"/>
      </geometry> -->
      <material name="blue">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>

  <!-- IMU -->
  <link name="imu_link">
    <visual>
      <!-- <geometry>
        <box size="0.05 0.05 0.02"/>
      </geometry> -->
      <material name="yellow">
        <color rgba="1 1 0 1"/>
      </material>
    </visual>
  </link>

  <!-- カメラリンク -->
  <link name="camera_link">
    <visual>
      <!-- <geometry>
        <box size="0.1 0.01 0.01"/>
      </geometry> -->
      <material name="purple">
        <color rgba="0.5 0 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- 各リンクの接続 -->
  <joint name="base_to_footprint" type="fixed">
    <parent link="base_link"/>
    <child link="base_footprint"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 底面高さ0.5537 + アンテナ中心高さ0.032 = 0.5857 -->
  <joint name="base_to_gnss_main" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_main_link"/>
    <origin xyz="-0.12 0.1 0.5857" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_gnss_sub" type="fixed">
    <parent link="base_link"/>
    <child link="gnss_sub_link"/>
    <origin xyz="-0.12 -0.1 0.5857" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_velodyne" type="fixed">
    <parent link="base_link"/>
    <child link="velodyne"/>
    <origin xyz="0.0 0 0.2492" rpy="0 0 0"/>
  </joint>

  <joint name="base_to_livox" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="-0.0379 0 0.5779" rpy="0 0.7854 0"/>
  </joint>

  <joint name="base_to_imu" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="-0.030 0 0.2034" rpy="3.14 0 0"/>
  </joint>

  <joint name="base_to_camera" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="-0.0589 0 0.5020" rpy="0 0.1745 0"/>
  </joint>

</robot>
