; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Cub Simulator"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/low_processor_mode=true

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/size/window_width_override=960
window/size/window_height_override=600
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0
window/size/min_width=640
window/size/min_height=420

[input_devices]

joypads/ignore_joypad_on_unfocused_application=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.78, 0.84, 0.9, 1)

[threading]

worker_pool/max_threads=2
